# ──────────────────────────────────────────────
# JavaScript / Node
# ──────────────────────────────────────────────

# Installed package dependencies — never committed; reproduced via npm/pnpm install
node_modules/

# ──────────────────────────────────────────────
# Turborepo
# ──────────────────────────────────────────────

# Local build cache — Turborepo stores hashed task outputs here for incremental
# builds. These are machine-specific binary blobs (.tar.zst) and metadata JSON
# that bloat the repo and differ across machines. Remote caching (Vercel/self-hosted)
# is the intended sharing mechanism.
.turbo/cache/

# Per-package build logs written by Turborepo during local runs. Not useful to
# other developers and change on every build.
**/.turbo/*.log

# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────

# Python virtual environment — contains interpreter symlinks and hundreds of
# installed package files. Reproduced via `python -m venv venv && pip install -r
# requirements.txt`. Committing venv bloats the repo (3 000+ files) and breaks
# on any machine with a different OS/Python patch version.
venv/
.venv/
env/

# Compiled bytecode — generated automatically by the Python interpreter at
# runtime and are platform-specific. They add noise to diffs and must never be
# distributed in source control.
__pycache__/
*.pyc
*.pyo

# pytest cache — local test-run state that has no meaning outside the machine
# that ran the tests.
.pytest_cache/

# ──────────────────────────────────────────────
# Build output
# ──────────────────────────────────────────────

# Compiled package output for viewer-core (and any future internal packages).
# These .js/.d.ts files are generated by the build step and should be
# reproducible from source via `pnpm build`. Committing dist means every source
# change requires a manual rebuild commit, creates merge conflicts on generated
# files, and inflates PR diffs with noise.
packages/*/dist/

# ──────────────────────────────────────────────
# Environment / secrets
# ──────────────────────────────────────────────

# Local environment variable files — may contain API keys, DB passwords, and
# other secrets. Only the .env.example template should be committed.
.env
.env.local
.env.*.local

# ──────────────────────────────────────────────
# OS / editor artefacts
# ──────────────────────────────────────────────

# macOS metadata files created by Finder — irrelevant to all other platforms.
.DS_Store

# Windows thumbnail cache — not relevant on macOS/Linux.
Thumbs.db

# JetBrains IDE project files (personal workspace config, not shared tooling).
.idea/

# VS Code workspace settings (personal; shared settings belong in
# .vscode/settings.json committed intentionally).
.vscode/
